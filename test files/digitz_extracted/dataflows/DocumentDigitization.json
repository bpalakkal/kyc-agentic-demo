    {
      "id": "dndnode_20",
      "type": "code",
      "props": {
        "name": null,
        "alias": "DigitizationCollector",
        "description": null,
        "code": "    /**\n     * The 'inputs' object contains all upstream node outputs, keyed by alias.\n     *\n     * INPUT FORMATS:\n     *   Tabular nodes  →  inputs['alias'] is an Array of row objects\n     *     Example: inputs['sales_data'] = [{ region: 'US', amount: 100 }, ...]\n     *\n     *   JSON object nodes  →  inputs['alias'] is a parsed JavaScript value\n     *     Example: inputs['api_response'] = { status: 'ok', results: [...] }\n     *\n     * OUTPUT FORMAT:\n     *   If output mode is \"tabular\"     —  outputData should be an Array of row objects\n     *   If output mode is \"json_object\" —  outputData can be any JavaScript value\n     */\n\n    // Get the first upstream input (use the alias key for a specific node)\n\n    const outputData = {}\n\n    const nodeNames = Object.keys(inputs);\n\n    for (const node of nodeNames) {\n        outputData[node] = inputs[node]\n    }\n",
        "outputMode": "json_object",
        "rowLimit": null,
        "validated": true
      }
    }
