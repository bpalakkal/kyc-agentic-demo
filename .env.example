# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
AGENT_REGISTRY_ADMIN_EMAILS=admin@example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Zoom
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# KYC Data Source API keys
COMPANIES_HOUSE_API_KEY=your_key   # developer.company-information.service.gov.uk
FCA_AUTH_EMAIL=your_email@example.com   # FCA Register API — x-auth-email header
FCA_API_KEY=your_fca_api_key            # FCA Register API — x-auth-key header
SEC_API_KEY=your_key                    # sec-api.io — IAPD (Form ADV) and SEC EDGAR enrichment
FIRECRAWL_API_KEY=fc-your_key           # Firecrawl Browser API — Delaware registry search

# Sanctions / PEP screening (no-Forge direct integration)
OPENSANCTIONS_API_KEY=               # api.opensanctions.org — required for screening runs

# Neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Frontend (injected at Vite build time)
VITE_AGENT_API_BASE=http://localhost:3001

# GitHub Pages base path
VITE_BASE_PATH=/kyc-agentic/

# CORS — comma-separated list of extra allowed origins (in addition to github.io)
# CORS_ORIGIN=https://your-custom-domain.com

# Health endpoint secret — set to enable detailed /api/health responses
# HEALTH_SECRET=your_secret_token
